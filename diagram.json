{
  "version": 1,
  "author": "Projeto Automação",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": 20, "left": -190, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 160, "left": 110, "attrs": { "color": "blue" } },
    { "type": "wokwi-led", "id": "led1", "top": -60, "left": 35, "attrs": { "color": "white" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

   
    [ "esp:GND.1", "ldr1:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "ldr1:VCC", "red", [ "v0" ] ],
    [ "esp:34", "ldr1:AO", "orange", [ "v0" ] ],


    [ "esp:GND.1", "btn1:1.L", "black", [ "v0" ] ],
    [ "esp:4", "btn1:2.R", "blue", [ "v0" ] ],


    [ "esp:GND.1", "led1:C", "black", [ "v0" ] ],
    [ "esp:2", "led1:A", "yellow", [ "v0" ] ]
  ]
}